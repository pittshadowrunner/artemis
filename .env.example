# Portainer stack environment — copy into the stack's env vars.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-admin
DB_USER=artemis_app
DB_PASSWORD=change-me-app
APP_PORT=8085
SPRING_PROFILES_ACTIVE=local-auth
# First boot only — creates the platform sysadmin if no users exist.
BOOTSTRAP_SYSADMIN_EMAIL=sysadmin@artemis.local
BOOTSTRAP_SYSADMIN_PASSWORD=change-me-sysadmin
# Shared Mailgun domain across the Squires Enterprises stacks.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.squiresenterprisesllc.com
MAIL_FROM=Artemis WMS <artemis@mail.squiresenterprisesllc.com>
# Only used by the caddy service (profile "edge").
WMS_DOMAIN=wms.squiresenterprisesllc.com
# Replenishment scan: on by default, every 60s. No button in the UI.
REPLEN_AUTO=true
REPLEN_SCAN_MS=60000
