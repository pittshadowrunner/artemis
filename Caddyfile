# Artemis WMS — standalone edge config.
#
# NOT normally used: the squires stack owns 80/443 for this host and routes
# wms.squiresenterprisesllc.com -> artemis-app:8080 over edge_net. This file
# only comes into play if the caddy service is started with the "edge"
# profile (dev box, or the squires stack is down).
{$WMS_DOMAIN:wms.squiresenterprisesllc.com} {
    tls {$ACME_EMAIL}
    reverse_proxy artemis-app:8080
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    request_body {
        max_size 50MB
    }
    log {
        output stdout
        format console
    }
}
